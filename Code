def get_product():
   product=input("What is the product ? ")
   while product.strip() == "" :
    product=input("Please try again input is empty")
   return product
 

def get_price():
   price=input("What is the price ? £")
   if price.startswith("£"):
       price=price[1:]
   try:
        price=float(price)
        
   except ValueError:
        print("It is not a number")
        return get_price()
   return price

def get_quantity():
   quantity=input("What is the quantity ? ")
   while quantity=="0" or quantity.strip()=="" or not quantity.isdigit() :  
     if quantity.strip() == "":
            print("Cant be empty")
     elif quantity == "0":
            print("Cant be 0")
     elif not quantity.isdigit():
            print("It is not a number")
     quantity=input("Please try again")
   return int(quantity)

def get_discount():
   discount=input("What is the discount ? ")
   if discount.strip()!=""  :
       if discount.endswith("%"):
          discount=discount[:-1]
         
       try:
          discount=float(discount)
             
       except ValueError:
           print("It is not a number")
           return get_discount()
       if discount>100 or discount<0:
           print("It is greater than 100 or less than 0")
           return get_discount()
       
       else:
         discount/=100
         return discount
   print("Discount cannot be empty")
   return get_discount()   
      

